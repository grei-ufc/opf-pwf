csv/
logs/
*.csv
*.xlsx
*.parquet
*.sqlite

# --- Standard Julia Files ---
*.jl.cov
*.jl.*.cov
*.jl.mem
*.ji
*.jld2
LocalPreferences.toml
JuliaLocalPreferences.toml

# --- IDEs & OS ---
.DS_Store
.vscode/
.idea/
